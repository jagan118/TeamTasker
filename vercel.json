{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "todo-app-backend": {
      "root": "todo-app-backend",
      "framework": "express"
    },
    "todo-app-frontend": {
      "root": "todo-app-frontend",
      "framework": "angular"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "todo-app-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "todo-app-frontend"
      }
    }
  ]
}
